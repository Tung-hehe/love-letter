---
// Màn 2: Phong cách thư. #picker-grid được app.ts render động (17 thẻ template)
// -> style is:global, xem ghi chú trong LibraryScreen.astro.
//
// Bấm 1 thẻ chỉ CHỌN (highlight + cập nhật xem trước bên phải nếu màn đủ rộng),
// không tự chuyển màn nữa. "Xác nhận" mới thật sự chuyển sang Soạn thư.
//
// 2 cách hiện nút tuỳ độ rộng màn (ngưỡng 1040px, khớp lúc xem trước bên phải
// xuất hiện — xem BaseLayout):
// - >=1040px (đã có xem trước bên phải): nút "Xác nhận" gọn trong thanh trên
//   cùng (#picker-confirm-top) — không cần "Xem mẫu" nữa, ẩn hẳn thanh dưới.
// - <1040px (điện thoại/tablet dọc, chưa có xem trước): thanh cố định ở đáy với
//   2 nút "Xem mẫu" + "Xác nhận" cân nhau.
---
<section id="screen-picker" class="screen">
  <div class="topbar">
    <button type="button" id="picker-back" class="icon-btn" aria-label="Quay lại">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
    </button>
    <h2>Phong cách thư</h2>
    <button type="button" id="picker-confirm-top" class="topbar-primary-btn">Xác nhận</button>
  </div>
  <div class="screen-body">
    <p class="subtitle">Mỗi phong cách một sắc thái riêng — chọn rồi xác nhận để bắt đầu soạn</p>
    <div id="picker-grid" class="picker-grid"></div>
  </div>
  <div class="picker-actions">
    <div class="picker-actions-inner">
      <button type="button" id="picker-view-sample" class="secondary-btn">Xem mẫu</button>
      <button type="button" id="picker-confirm" class="primary-btn">Xác nhận</button>
    </div>
  </div>
</section>

<style is:global>
  /* Thẻ dạng ô vuông, icon + tên căn giữa — gọn và "sạch" hơn hàng ngang có thêm
     dòng mô tả tâm trạng (đã bỏ, tên phong cách là đủ rõ). */
  .picker-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
  @media (max-width:420px){
    .picker-grid{grid-template-columns:repeat(2,1fr);}
  }
  .theme-card{
    position:relative;
    display:flex;flex-direction:column;align-items:center;text-align:center;gap:9px;
    width:100%;padding:16px 8px 13px;background:var(--paper-raised);
    border:0.5px solid var(--border);border-radius:16px;font-family:inherit;color:inherit;
    transition:border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }
  .theme-card.picked{
    border:1.5px solid var(--accent);background:var(--accent-bg);
    box-shadow:0 6px 16px var(--shadow);
  }
  @media (hover:hover){
    .theme-card:not(.picked):hover{border-color:var(--border-strong);box-shadow:0 4px 10px var(--shadow);}
  }
  .t-swatch{
    width:46px;height:46px;flex-shrink:0;border-radius:14px;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 3px 8px var(--shadow);
  }
  .t-swatch svg{width:22px;height:22px;}
  .t-name{font-size:12px;font-weight:600;margin:0;color:var(--ink);line-height:1.3;}
  .t-check{
    position:absolute;top:-6px;right:-6px;width:19px;height:19px;border-radius:50%;
    background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;
    box-shadow:0 2px 6px var(--shadow);
    opacity:0;transform:scale(0.5);transition:opacity 0.15s ease, transform 0.15s ease;
  }
  .t-check svg{width:11px;height:11px;}
  .theme-card.picked .t-check{opacity:1;transform:scale(1);}

  /* Thanh hành động dưới cùng: nội dung căn theo đúng chiều rộng cột nội dung
     (520px, khớp .screen-body) thay vì kéo dài hết cỡ trên màn hình rộng. */
  .picker-actions{
    flex-shrink:0;position:sticky;bottom:0;
    padding:12px 18px calc(14px + env(safe-area-inset-bottom));
    border-top:0.5px solid var(--border);background:var(--paper);
  }
  .picker-actions-inner{display:flex;gap:10px;max-width:520px;margin:0 auto;width:100%;}
  .picker-actions-inner .secondary-btn, .picker-actions-inner .primary-btn{margin:0;box-shadow:none;flex:1;}
  .picker-actions-inner .primary-btn{box-shadow:0 10px 22px var(--shadow);}

  /* Từ ngưỡng có xem trước trực tiếp bên phải (xem BaseLayout): dùng nút gọn
     trong thanh trên cùng thay cho thanh cố định ở đáy. */
  @media (min-width:1040px){
    #picker-confirm-top{display:inline-flex;}
    .picker-actions{display:none;}
  }
</style>
