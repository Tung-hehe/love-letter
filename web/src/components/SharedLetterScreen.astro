---
// Màn "Xem thư qua link chia sẻ" (/xem/:data) — dữ liệu thư nằm ngay trong URL
// (xem lib/shareLink.ts), không tra localStorage/thư viện. Chỉ để ĐỌC: không có
// nút Lưu/Sửa, chỉ có 1 nút nhỏ mời người xem tự tạo thư của riêng họ (kênh giới
// thiệu app tự nhiên tới đúng người có nhu cầu).
---
<section id="screen-shared" class="screen">
  <iframe id="shared-frame" title="Thư gửi bạn"></iframe>
  <a href="/" class="shared-cta">✍️ Tạo thư của riêng bạn</a>
</section>

<style>
  #screen-shared{position:relative;}
  #shared-frame{flex:1;width:100%;border:none;background:#fff;}
  .shared-cta{
    position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%);
    display:inline-flex;align-items:center;gap:6px;white-space:nowrap;
    background:var(--accent-fill);color:#fff;font-size:13.5px;font-weight:600;
    padding:10px 18px;border-radius:999px;box-shadow:0 6px 18px var(--shadow);
    text-decoration:none;
  }
</style>
